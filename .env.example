#!/bin/bash
# Fichier de configuration d'environnement - Sourcer avant déploiement

# Répertoires du projet
export PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export TERRAFORM_DIR="${PROJECT_ROOT}/terraform"
export ANSIBLE_DIR="${PROJECT_ROOT}/ansible"
export KUBERNETES_DIR="${PROJECT_ROOT}/kubernetes"
export SCRIPTS_DIR="${PROJECT_ROOT}/scripts"
export DOCS_DIR="${PROJECT_ROOT}/docs"

# Kubeconfig et Talos config
export KUBECONFIG="${HOME}/.kube/config"
export TALOSCONFIG="${HOME}/.talos/config"

# Versions
export KUBERNETES_VERSION="1.28.4"
export TALOS_VERSION="1.6.0"
export ENVOY_GATEWAY_VERSION="latest"
export NGINX_INGRESS_VERSION="1.9.6"

# Cluster configuration
export CLUSTER_NAME="nginx-to-gateway-cluster"
export CLUSTER_DOMAIN="cluster.local"
export ENVIRONMENT="staging"

# Network
export NETWORK_GATEWAY="x.x.x.1"
export POD_SUBNET="10.244.0.0/16"
export SERVICE_SUBNET="10.96.0.0/12"
export DNS_SERVERS="8.8.8.8,8.8.4.4"

# Proxmox
export PROXMOX_NODE="proxmox-node"
export PROXMOX_BRIDGE="vmbr0"
export TALOS_TEMPLATE="talos-template"

# Control Plane
export CONTROL_PLANE_IP="x.x.x.130"
export CONTROL_PLANE_ENDPOINT="x.x.x.130:6443"

# Workers
export WORKER_IPS="x.x.x.132,x.x.x.133"
export WORKER_COUNT="2"

# Observability
export OBSERVABILITY_IP="x.x.x.131"
export PROMETHEUS_RETENTION="15d"
export LOKI_RETENTION="7d"

# Logging
export LOG_LEVEL="info"
export LOG_DIR="${PROJECT_ROOT}/logs"

# Ansible
export ANSIBLE_INVENTORY="${ANSIBLE_DIR}/inventory/hosts"
export ANSIBLE_CONFIG="${ANSIBLE_DIR}/ansible.cfg"

# Colors
export RED='\033[0;31m'
export GREEN='\033[0;32m'
export YELLOW='\033[1;33m'
export BLUE='\033[0;34m'
export NC='\033[0m'

# Functions
print_header() {
    echo -e "${BLUE}╔════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║ $1${NC}"
    echo -e "${BLUE}╚════════════════════════════════════════════════════════════╝${NC}"
}

print_info() {
    echo -e "${BLUE}$1${NC}"
}

print_success() {
    echo -e "${GREEN}$1${NC}"
}

print_error() {
    echo -e "${RED}$1${NC}"
}

print_warning() {
    echo -e "${YELLOW}$1${NC}"
}

# Create logs directory if it doesn't exist
mkdir -p "${LOG_DIR}"

# Display configuration summary
print_header "Migration NGINX Ingress → Gateway API"
echo ""
print_info "Project Root: ${PROJECT_ROOT}"
print_info "Environment: ${ENVIRONMENT}"
print_info "Cluster: ${CLUSTER_NAME}"
print_info "Kubernetes: ${KUBERNETES_VERSION}"
echo ""
